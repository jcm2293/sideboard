    "feats": [
      {
        "name": "Lucky",
        "summary": "spend a point for advantage on your d20, or disadvantage on an attack against you",
        "full_text": "Luck Points. You have 3 Luck Points that you can spend on the benefits below. You regain expended Luck Points after a Long Rest.\n\nAdvantage. When you roll a d20 for a D20 Test, you can spend 1 Luck Point to give yourself Advantage on the roll.\n\nDisadvantage. When a creature rolls a d20 for an attack roll against you, you can spend 1 Luck Point to impose Disadvantage on that roll.",
        "kind": "mechanical",
        "group": "Feats",
        "action": "special",
        "uses": {
          "count": 3,
          "per": "long",
          "label": "Luck Points"
        },
        "source_ref": "PHB-2024 201"
      },
      {
        "name": "Tough",
        "summary": "+2 HP per level",
        "full_text": "When you take this feat, your HP maximum increases by 10. Whenever you gain a character level thereafter, your HP maximum increases an additional 2 HP.",
        "kind": "ribbon",
        "group": "Feats",
        "source_ref": "PHB-2024 202"
      }
