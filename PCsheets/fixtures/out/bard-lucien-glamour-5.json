    "class_features": [
      {
        "name": "Bardic Inspiration",
        "summary": "give a creature within 60 ft a d8 to add to a failed D20 Test",
        "full_text": "As a Bonus Action, you can inspire another creature within 60 ft. that can see or hear you. That creature gains one of your Bardic Inspiration dice (1d6). Once within the next hour, when the creature fails a D20 Test, the creature can roll the Bardic Inspiration die and add the number rolled to the total, potentially turning the failure into a success.\n\nYou can confer your Bardic Inspiration die 4 times per Long Rest.",
        "kind": "mechanical",
        "group": "Bard",
        "action": "bonus",
        "uses": {
          "count": 4,
          "per": "short"
        },
        "source_ref": "PHB-2024 59"
      },
      {
        "name": "Spellcasting",
        "summary": "cast spells through your bardic arts",
        "full_text": "You can cast spells through your bardic arts. Charisma is your spellcasting ability for your Bard spells (Spell DC 15, Spell Attack +7). You can use a Musical Instrument as a Spellcasting Focus for your Bard spells.",
        "kind": "container",
        "group": "Bard",
        "source_ref": "PHB-2024 59"
      },
      {
        "name": "Expertise",
        "summary": "double your proficiency bonus with two chosen skills",
        "full_text": "You gain Expertise in two skill proficiencies of your choice.",
        "kind": "ribbon",
        "group": "Bard",
        "source_ref": "PHB-2024 60"
      },
      {
        "name": "Jack of All Trades",
        "summary": "add half your proficiency bonus to ability checks you lack proficiency in",
        "full_text": "You can add half your Proficiency Bonus (1) to ability checks you make that uses a skill proficiency you lack and that doesn’t otherwise use your Proficiency Bonus.",
        "kind": "mechanical",
        "group": "Bard",
        "source_ref": "PHB-2024 60"
      },
      {
        "name": "Beguiling Magic",
        "summary": "after an Enchantment or Illusion slot spell, charm or frighten a creature within 60 ft (Wis save)",
        "full_text": "You always have Charm Person and Mirror Image prepared. In addition, immediately after you cast an Enchantment or Illusion spell using a spell slot, you can cause a creature you can see within 60 ft. of you to make a DC 15 Wis. saving throw. On a failed save, the target has the Charmed or Frightened condition (your choice) for 1 minute, and it repeats the save at the end of each of its turns, ending the effect on itself on a success.\n\nYou can only use this benefit once per Long Rest, but you can also restore your use of it by expending one use of your Bardic Inspiration (no action required).",
        "kind": "mechanical",
        "group": "Bard",
        "action": "action",
        "uses": {
          "count": 1,
          "per": "long"
        },
        "source_ref": "PHB-2024 65",
        "activations": [
          {
            "label": "Regain Use",
            "action": "none"
          }
        ]
      },
      {
        "name": "Mantle of Inspiration",
        "summary": "spend Bardic Inspiration: allies within 60 ft gain temp HP and can move without provoking",
        "full_text": "As a Bonus Action, you can expend a use of Bardic Inspiration, rolling a Bardic Inspiration die (1d8). When you do, choose up to +4 creatures within 60 ft. of yourself. Each of those creatures gains Temporary HP equal to two times the number rolled on the Bardic Inspiration die, and then can use its reaction to move up to its Speed without provoking Opportunity Attacks.",
        "kind": "mechanical",
        "group": "Bard",
        "action": "bonus",
        "source_ref": "PHB-2024 65"
      },
      {
        "name": "Font of Inspiration",
        "summary": "Bardic Inspiration returns on a short rest; spend a slot to regain one use",
        "full_text": "You now regain all expended uses of Bardic Inspiration when you finish a Short or Long Rest.\n\nIn addition, you can expend a spell slot (no action required) to regain one expended use of Bardic Inspiration.",
        "kind": "mechanical",
        "group": "Bard",
        "source_ref": "PHB-2024 61",
        "activations": [
          {
            "label": "Regain Bardic Inspiration",
            "action": "special"
          }
        ]
      }
    ],
